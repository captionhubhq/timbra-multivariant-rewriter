{
  "name": "timbra-multivariant-rewriter",
  "version": "1.0.0",
  "description": "Rewrites a multivariant HLS playlist to add subtitle tracks, as an AWS Lambda or a CLI.",
  "main": "dist/index.js",
  "bin": {
